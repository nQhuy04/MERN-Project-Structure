{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "migrate-mongo up -f migrate-mongo-config.js",
    "db:migrate:down": "migrate-mongo down -f migrate-mongo-config.js",
    "db:migrate:status": "migrate-mongo status -f migrate-mongo-config.js",
    "db:migrate:create": "migrate-mongo create -f migrate-mongo-config.js",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "aws4fetch": "^1.0.20",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^9.10.2",
    "nodemailer": "^10.0.12",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.30.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "vitest": "^5.0.2"
  }
}
