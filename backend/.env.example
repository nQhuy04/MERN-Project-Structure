# Sao chép thành backend/.env rồi điền giá trị. Không commit file .env.
# Biến được validate bằng Zod khi khởi động (src/shared/config/env.js) — sai là dừng ngay.

# Môi trường: development | test | production. Quyết định các giá trị mặc định bên dưới.
NODE_ENV=development

# Cổng HTTP của API.
PORT=4000

# Chuỗi kết nối MongoDB. Dự án dùng transaction nên cần replica set (MongoDB Atlas có sẵn).
# Ví dụ Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mern_base_dev?retryWrites=true&w=majority
MONGODB_URI=

# Danh sách origin frontend được gọi API (có gửi cookie), phân tách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5173

# URL frontend, dùng để dựng link trong email (xác thực, đặt lại mật khẩu...).
# Bỏ trống = http://localhost:5173 (bắt buộc ở production).
APP_URL=

# Số proxy đứng trước app (để lấy đúng IP client cho rate limit).
# Bỏ trống = mặc định: 0 ở development/test, 1 ở production (Render).
TRUST_PROXY=

# Mức log: fatal | error | warn | info | debug | trace | silent.
# Bỏ trống = mặc định: debug ở development, silent ở test, info ở production.
LOG_LEVEL=

# Cost của bcrypt khi hash mật khẩu (10–15). Mỗi +1 chậm gấp đôi. Bỏ trống = 12.
BCRYPT_COST=

# Bật/tắt rate limit cho các route auth (true/false). Bỏ trống = true.
RATE_LIMIT_ENABLED=

# Khoá ký access token (JWT), tối thiểu 32 ký tự. Sinh bằng: openssl rand -base64 48
JWT_ACCESS_SECRET=

# Cookie chứa refresh token. SameSite: lax (mặc định — frontend gọi API cùng site, vd. proxy
# /api qua Vercel) | strict | none (frontend khác site — bắt buộc COOKIE_SECURE=true).
COOKIE_SAME_SITE=
# true = chỉ gửi cookie qua HTTPS. Bỏ trống = bật ở production, tắt ở development.
COOKIE_SECURE=

# --- Google OAuth (tuỳ chọn) ---
# Đủ cả 3 biến = bật đăng nhập Google; bỏ trống cả 3 = tắt (nút Google bị ẩn, endpoint trả 404).
# Tạo OAuth Client (Web application) tại https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Phải khai báo đúng URL này trong "Authorized redirect URIs" của Google.
# Ví dụ dev: http://localhost:4000/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- Cloudflare R2 (tuỳ chọn) ---
# Đủ cả 4 biến = bật lưu trữ file / ảnh; bỏ trống cả 4 = tắt (endpoint trả 404, FE ẩn chức năng).
# Tạo R2 API token (quyền Object Read & Write cho bucket) trong Cloudflare Dashboard → R2.
# Bucket phải cấu hình CORS cho origin của frontend — xem docs/05-storage-va-email.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Lịch tự động ---
# Múi giờ IANA để hiểu "lúc HH:mm" của job. Bỏ trống = Asia/Ho_Chi_Minh.
JOBS_TIMEZONE=
# Bộ chạy job trong tiến trình (kiểm tra mỗi phút). Bỏ trống = true.
# Nền tảng hay "ngủ" server (Render free) → dùng thêm endpoint kích hoạt từ ngoài bên dưới.
JOBS_RUNNER_ENABLED=
# Secret (≥ 32 ký tự) cho POST /api/v1/jobs/trigger (header X-Jobs-Secret) — để cron bên ngoài
# gọi định kỳ. Bỏ trống = tắt endpoint. Sinh bằng: openssl rand -base64 48
JOBS_TRIGGER_SECRET=

# --- Email ---
# Có 3 kênh gửi. Super Admin chọn kênh ở trang Quản trị → Cấu hình → "Kênh gửi email" (chỉ chọn
# được kênh đã điền đủ biến bên dưới). Hướng dẫn lấy từng biến: docs/05-storage-va-email.md §3.3.
#   console: in email (kèm link) ra terminal, không gửi thật — không cần biến nào.
#   resend : gửi qua HTTP API của Resend — cần domain riêng đã xác minh.
#   smtp   : gửi qua máy chủ SMTP của Gmail bằng Nodemailer — miễn phí, không cần domain.
#            Chạy được ở local / VPS; Render gói free chặn cổng SMTP → không gửi được (docs 05).
#
# Kênh mặc định khi Super Admin chưa chọn: console | resend | smtp.
# Bỏ trống = console ở development/test; production dùng resend nếu có RESEND_API_KEY, không thì smtp.
EMAIL_DELIVERY=
# Người gửi hiển thị, dạng "Tên <email>". Bắt buộc khi dùng Resend (email thuộc domain đã xác minh).
# Bỏ trống khi chỉ dùng SMTP = "MERN Base <SMTP_USER>".
EMAIL_FROM=

# Resend (tuỳ chọn): API key tạo ở https://resend.com/api-keys (quyền Sending access).
RESEND_API_KEY=

# SMTP (tuỳ chọn): đủ cả SMTP_HOST, SMTP_USER, SMTP_PASS = bật; bỏ trống cả 3 = tắt.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=<địa chỉ gmail>, SMTP_PASS=<App Password 16 ký tự,
#        KHÔNG phải mật khẩu Gmail> — tạo tại https://myaccount.google.com/apppasswords (cần bật
#        xác minh 2 bước).
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# Cổng: 587 (STARTTLS, mặc định) | 465 (TLS ngay từ đầu). Bỏ trống = 587.
SMTP_PORT=
# true = TLS ngay từ đầu. Bỏ trống = true nếu SMTP_PORT=465, còn lại false (STARTTLS).
SMTP_SECURE=

# --- Chỉ dùng cho `npm run db:seed` (tạo Super Admin nếu hệ thống chưa có) ---
# Hệ thống luôn có đúng 1 Super Admin. Đã có thì seed bỏ qua, kể cả khi đổi email ở đây.
SEED_SUPER_ADMIN_EMAIL=
# Tối thiểu 8 ký tự, tối đa 72 byte. Đổi mật khẩu ngay sau lần đăng nhập đầu.
SEED_SUPER_ADMIN_PASSWORD=
# Bỏ trống = "Super Admin".
SEED_SUPER_ADMIN_NAME=
