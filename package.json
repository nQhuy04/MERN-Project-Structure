{
  "name": "mern-stack-practice",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check-conventions.mjs",
    "db:migrate": "npm run db:migrate -w backend",
    "db:migrate:down": "npm run db:migrate:down -w backend",
    "db:migrate:status": "npm run db:migrate:status -w backend",
    "prepare": "husky || true",
    "db:seed": "npm run db:seed -w backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
